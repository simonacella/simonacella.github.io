{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":semanticCommits",
		":disableRateLimiting",
		"mergeConfidence:all-badges"
	],
	"labels": ["dependencies"],
	"rangeStrategy": "bump",
	"minimumReleaseAge": "1 day",
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["at any time"]
	},
	"customManagers": [
		{
			"customType": "regex",
			"description": "Pinned @sveltia/cms unpkg URLs in admin (script + schema)",
			"managerFilePatterns": ["/^admin\\/(index\\.html|config\\.yml)$/"],
			"matchStrings": [
				"unpkg\\.com/(?<depName>@sveltia/cms)@(?<currentValue>[^/\"'\\s?#]+)"
			],
			"datasourceTemplate": "npm",
			"versioningTemplate": "npm"
		}
	],
	"packageRules": [
		{
			"description": "Jekyll and its plugins",
			"matchManagers": ["bundler"],
			"matchPackageNames": [
				"jekyll",
				"/^jekyll-/"
			],
			"groupName": "jekyll stack"
		},
		{
			"description": "GitHub Actions",
			"matchManagers": ["github-actions"],
			"groupName": "github actions"
		},
		{
			"description": "Sveltia CMS CDN pins — review release notes before merge",
			"matchPackageNames": ["@sveltia/cms"],
			"groupName": "sveltia cms",
			"automerge": false
		}
	]
}
